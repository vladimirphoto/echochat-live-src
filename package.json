{
  "name": "echochat-live",
  "version": "3.5.18",
  "description": "ЭхоЧат LIVE — озвучка чата TikTok LIVE живыми нейро-голосами",
  "main": "main.js",
  "author": "EchoChat",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "pages": "node tools/build-pages.js",
    "dist": "electron-builder --win portable --x64",
    "dist:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "centrifuge": "^2.8.5",
    "msedge-tts": "^2.0.0",
    "qrcode-generator": "^1.4.4",
    "tiktok-live-connector": "^2.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "live.echochat.app",
    "productName": "EchoChat LIVE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "fetch-retry.js",
      "errors.js",
      "events.js",
      "twitch.js",
      "widget.js",
      "widget-page.js",
      "widget-donate-page.js",
      "widget-likes-page.js",
      "widget-gifts-page.js",
      "widget-alert-page.js",
      "widget-avatar-page.js",
      "widget-avatar3d-page.js",
      "avatar.js",
      "avatar-preload.js",
      "widget-da-page.js",
      "da-auth-page.js",
      "donationalerts.js",
      "alerts.js",
      "overlay.js",
      "overlay-preload.js",
      "kaspi.js",
      "license.js",
      "machine.js",
      "relay.js",
      "tts-engines.js",
      "edge-pool.js",
      "shortcut.js",
      "selftest.js",
      "src/**/*",
      "package.json",
      "!tools/**",
      "assets/**"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EchoChat-LIVE-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ЭхоЧат LIVE",
      "uninstallDisplayName": "ЭхоЧат LIVE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "EchoChat-LIVE-Setup-${version}.${ext}"
    },
    "afterPack": "tools/adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "src/icon.png",
      "identity": null,
      "extendInfo": { "NSCameraUsageDescription": "Камера нужна, чтобы аватар повторял ваше лицо." },
      "artifactName": "EchoChat-LIVE-${version}-mac-arm64.${ext}"
    }
  }
}
